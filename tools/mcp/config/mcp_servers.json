{
  "mcpServers": {
    "filesystem": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "./safe_test/"
      ],
      "confirm": [
        "write_file",
        "edit_file",
        "move_file",
        "create_directory"
      ]
    },
    "web": {
      "transport": "stdio",
      "command": "python3",
      "args": [
        "tools/mcp/servers/web_server.py"
      ]
    },
    "time": {
      "transport": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-time"
      ]
    },
    "blender": {
      "transport": "stdio",
      "command": "uvx",
      "args": [
        "blender-mcp"
      ],
      "env": {
        "DISABLE_TELEMETRY": "true"
      },
      "confirm": [
        "execute_blender_code"
      ]
    }
  }
}
